#!/data/data/com.termux/files/usr/bin/python
# Side-by-side ("split") workspaces get a fixed layout, and their kitty windows drop the watermark:
#   2 windows: 1 | 2      3 windows: 1 | 2/3      4 windows: 2x2 grid      5+: equal columns
# Tabbed workspaces (the default) are left alone and keep the watermark.
#   omp-tile daemon   follow i3 window events (i3 autostart; replaces a running daemon)
#   omp-tile toggle   Super+S: switch the focused workspace between tabbed and split
#   omp-tile test     self-check of the layout logic, no i3 needed
import json, os, signal, subprocess, sys, time

SOCK = os.path.join(os.environ.get("TMPDIR", "/tmp"), "kitty-{}")   # listen_on in kitty.conf
WATERMARK = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "config", "kitty", "watermark.png")
TARGET = {2: "h[L,L]", 3: "h[L,v[L,L]]", 4: "h[v[L,L],v[L,L]]"}


def i3(*args):
    return subprocess.run(["i3-msg", *args], capture_output=True, text=True).stdout


def leaves(node):
    if node.get("window") and node["type"] == "con":
        return [node]
    return [l for c in node.get("nodes", []) for l in leaves(c)]


def sig(node):
    """Shape of a container: L = window, h[...] / v[...] = split, t[...] = tabbed or stacked."""
    if node.get("window"):
        return "L"
    kids = node.get("nodes", [])
    if len(kids) == 1:
        return sig(kids[0])   # a container with one child doesn't change the shape
    kind = {"splith": "h", "splitv": "v"}.get(node["layout"], "t")
    return kind + "[" + ",".join(sig(k) for k in kids) + "]"


def workspaces(tree):
    if tree["type"] == "workspace" and not tree["name"].startswith("__"):
        yield tree
    for c in tree.get("nodes", []):
        yield from workspaces(c)


def is_split(ws):
    return "t[" not in sig(ws) and leaves(ws)


def plan(ids, layout="splith"):
    """i3 commands that arrange the windows ids (in order) into the TARGET shape, or all as tabs."""
    m = [f"_omp{i}" for i in range(len(ids))]
    cmds = [f"[con_id={c}] mark --add {m[i]}" for i, c in enumerate(ids)]
    # flatten: every window becomes a sibling of the first, in order
    cmds += [f"[con_id={ids[i]}] move window to mark {m[i - 1]}" for i in range(1, len(ids))]
    cmds.append(f"[con_id={ids[0]}] layout {layout}")
    if layout == "splith" and len(ids) == 3:   # 1 | 2/3
        cmds += [f"[con_id={ids[1]}] split v", f"[con_id={ids[2]}] move window to mark {m[1]}"]
    elif layout == "splith" and len(ids) == 4:   # 1 2 / 3 4
        cmds += [f"[con_id={ids[0]}] split v", f"[con_id={ids[2]}] move window to mark {m[0]}",
                 f"[con_id={ids[1]}] split v", f"[con_id={ids[3]}] move window to mark {m[1]}"]
    cmds += [f"[con_id={c}] unmark {m[i]}" for i, c in enumerate(ids)]
    return cmds


def arrange(ws, focused):
    wins = leaves(ws)
    want = TARGET.get(len(wins), "h[" + ",".join("L" * len(wins)) + "]")
    if len(wins) < 2 or sig(ws) == want:
        return
    i3("; ".join(plan([w["id"] for w in wins]) + ([f"[con_id={focused}] focus"] if focused else [])))


pids = {}


def kitty_pid(wid):
    if wid not in pids:
        out = subprocess.run(["xprop", "-id", str(wid), "_NET_WM_PID"], capture_output=True, text=True).stdout
        pids[wid] = out.split("=")[-1].strip() if "=" in out else None
    return pids[wid]


shown = {}


def watermark(ws, on):
    """Returns False if a kitty didn't answer yet (a new kitty opens its socket after the window maps)."""
    ok = True
    for w in leaves(ws):
        if (w.get("window_properties") or {}).get("class") != "kitty" or shown.get(w["window"]) == on:
            continue
        pid = kitty_pid(w["window"])
        if pid and subprocess.run(["kitten", "@", "--to", "unix:" + SOCK.format(pid), "set-background-image",
                                   "--all", WATERMARK if on else "none"], capture_output=True).returncode == 0:
            shown[w["window"]] = on
        else:
            ok = False
    return ok


def focused_id(node):
    if node.get("focused"):
        return node["id"]
    for c in node.get("nodes", []) + node.get("floating_nodes", []):
        f = focused_id(c)
        if f:
            return f


def refresh():
    tree = json.loads(i3("-t", "get_tree"))
    f = focused_id(tree)
    ok = True
    for ws in workspaces(tree):
        split = is_split(ws)
        if split:
            arrange(ws, f)
        ok = watermark(ws, not split) and ok
    return ok


def toggle():
    tree = json.loads(i3("-t", "get_tree"))
    ws = next(w for w in workspaces(tree) if focused_id(w))
    wins = leaves(ws)
    if not wins:
        return
    if is_split(ws):   # back to one tab per window
        i3("; ".join(plan([w["id"] for w in wins], "tabbed") + [f"[con_id={focused_id(ws)}] focus"]))
    else:
        i3(f"[con_id={wins[0]['id']}] layout splith")   # refresh() then arranges it
    refresh()


def daemon():
    pidfile = os.path.join(os.environ.get("TMPDIR", "/tmp"), "omp-tile.pid")
    try:
        os.kill(int(open(pidfile).read()), signal.SIGTERM)
    except (OSError, ValueError):
        pass
    open(pidfile, "w").write(str(os.getpid()))
    while True:   # i3 restarts drop the subscription: reconnect
        refresh()
        sub = subprocess.Popen(["i3-msg", "-t", "subscribe", "-m", '["window"]'],
                               stdout=subprocess.PIPE, text=True)
        for line in sub.stdout:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if ev.get("change") in ("new", "close", "move", "floating"):
                for _ in range(10):   # wait up to ~3 s for a new kitty's socket
                    if refresh():
                        break
                    time.sleep(0.3)
        time.sleep(1)


def test():
    assert plan([1, 2])[-3:] == ["[con_id=1] layout splith", "[con_id=1] unmark _omp0", "[con_id=2] unmark _omp1"]
    p3 = plan([1, 2, 3])
    assert "[con_id=2] split v" in p3 and "[con_id=3] move window to mark _omp1" in p3
    p4 = plan([1, 2, 3, 4])
    assert p4.index("[con_id=1] split v") < p4.index("[con_id=3] move window to mark _omp0")
    assert not any("split v" in c for c in plan([1, 2, 3, 4], "tabbed"))
    leaf = {"window": 1, "type": "con"}
    v = {"layout": "splitv", "nodes": [leaf, leaf]}
    assert sig({"layout": "splith", "nodes": [leaf, v]}) == TARGET[3]
    assert sig({"layout": "splith", "nodes": [v, v]}) == TARGET[4]
    assert sig({"layout": "splith", "nodes": [{"layout": "tabbed", "nodes": [leaf, leaf]}]}) == "t[L,L]"
    print("ok")


{"daemon": daemon, "toggle": toggle, "test": test}[sys.argv[1] if len(sys.argv) > 1 else "test"]()
