#!/data/data/com.termux/files/usr/bin/sh
# Claude Code's linux-arm64 glibc build, started through glibc's loader. Termux's LD_PRELOAD
# (termux-exec, a bionic lib) can't load into a glibc process, so it's dropped here. Claude's Bash tool
# runs through a "bash" wrapper that puts it back before bash starts: bash itself must have termux-exec
# loaded, or scripts with #!/usr/bin/env fail (exit 126). Self-update is off: re-run install.sh instead.
d="$HOME/.local/share/claude-glibc"
printf '#!%s/bin/sh\nexport LD_PRELOAD=%s\nexec %s/bin/bash "$@"\n' "$PREFIX" \
    "${LD_PRELOAD:-$PREFIX/lib/libtermux-exec-ld-preload.so}" "$PREFIX" > "$d/bash"
chmod +x "$d/bash"
rm -f "$d/env.sh"   # old LD_PRELOAD-restoring CLAUDE_ENV_FILE: too late for bash's own execs
export CLAUDE_CODE_SHELL="$d/bash" DISABLE_AUTOUPDATER=1
exec env -u LD_PRELOAD "$PREFIX/glibc/lib/ld-linux-aarch64.so.1" "$d/claude" "$@"
