;; Generated by omarchy-pad render.sh from configs/eww/eww.yuck.tpl - edit the template.
;; Only data Android lets a Termux app read is shown (RAM, SoC temperature); no fake CPU/GPU/battery numbers.
(defpoll clock_time :interval "10s" "date +%H:%M")
(defpoll clock_date :interval "60s" "date '+%A, %B %-d'")
(defpoll ram_pct    :interval "5s"  "@SCRIPTS@/stat-ram.sh pct")
(defpoll ram_txt    :interval "5s"  "@SCRIPTS@/stat-ram.sh text")
(defpoll temp_c     :interval "10s" "@SCRIPTS@/status-temp.sh num")

(defwidget ring [value label caption class]
  (box :orientation "v" :spacing @px:6@ :halign "center"
    (overlay
      (circular-progress :class {"ring " + class} :value value :thickness @px:9@ :start-at 75 :clockwise true
                         :width @px:96@ :height @px:96@)
      (label :class "ring-value" :text label))
    (label :class "ring-caption" :text caption)))

(defwindow clock
  :monitor 0
  :geometry (geometry :x "@px:40@px" :y "@px:70@px" :width "@px:330@px" :height "@px:150@px" :anchor "top left")
  :stacking "bg"
  :windowtype "normal"
  :focusable false
  (box :class "card" :orientation "v" :hexpand true :vexpand true
    (label :class "time" :text clock_time)
    (label :class "date" :text clock_date)))

(defwindow stats
  :monitor 0
  :geometry (geometry :x "@px:40@px" :y "@px:250@px" :width "@px:330@px" :height "@px:190@px" :anchor "top left")
  :stacking "bg"
  :windowtype "normal"
  :focusable false
  (box :class "card" :orientation "h" :spacing @px:24@ :hexpand true :vexpand true :halign "fill" :valign "fill"
    (ring :value ram_pct :label "${ram_pct}%" :caption "RAM" :class "ring-ram")
    (ring :value {temp_c > 100 ? 100 : temp_c} :label "${temp_c}°" :caption "SoC" :class "ring-temp")))
