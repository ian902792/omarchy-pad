# Generated by omarchy-pad render.sh from configs/picom/picom.conf.tpl - edit the template.
# xrender backend: no GL needed (stable under Termux:X11). Blur is not available with it.
backend = "xrender";
vsync = false;

corner-radius = @px:14@;
rounded-corners-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "class_g = 'Plank'",
  "class_g = 'Polybar'",
  "class_g = 'eww'"
];

shadow = true;
shadow-radius = @px:22@;
shadow-offset-x = 0;
shadow-offset-y = @px:8@;
shadow-opacity = 0.55;
shadow-exclude = [
  "window_type = 'desktop'",
  "window_type = 'dock'",
  "class_g = 'Polybar'",
  "class_g = 'Plank'",
  "class_g = 'eww'"
];

fading = true;
fade-in-step = 0.08;
fade-out-step = 0.08;

# Slightly see-through terminal, like the reference rice
opacity-rule = [ "92:class_g = 'Xfce4-terminal'" ];

wintypes:
{
  dock = { shadow = false; };
  desktop = { shadow = false; };
  popup_menu = { opacity = 0.96; };
  dropdown_menu = { opacity = 0.96; };
};
