# omarchy-pad shell setup; sourced from ~/.bashrc (install.sh adds the line).
export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nvim

HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoredups:erasedups
shopt -s histappend checkwinsize

alias grep='grep --color=auto'
alias g=git
alias lg=lazygit

# CLI tools (install.sh): eza for ls, bat for cat (base16 = the terminal's Tokyo Night colors),
# zoxide for "z <part of a path>"; fd, delta (git diff, via config/gitconfig) and uv need no setup.
if command -v eza >/dev/null; then
    alias ls='eza --icons=auto'
    alias ll='eza -lah --icons=auto --git'
    alias tree='eza --tree --icons=auto'
else
    alias ls='ls --color=auto'
    alias ll='ls -lah --color=auto'
fi
export BAT_THEME=base16
command -v bat >/dev/null && alias cat='bat --paging=never --style=plain'
command -v zoxide >/dev/null && eval "$(zoxide init bash)"

command -v starship >/dev/null && eval "$(starship init bash)"
