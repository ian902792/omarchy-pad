# Android lets Termux read only /proc/meminfo and thermal_zone0; battery/network/cpu are denied.
# Battery comes from Termux:API, added by bin/omp-status (which runs this).
general {
    output_format = "i3bar"
    colors = true
    color_good = "#9ece6a"
    color_degraded = "#e0af68"
    color_bad = "#f7768e"
    interval = 5
}
order += "memory"
order += "cpu_temperature 0"
order += "tztime local"

memory {
    format = "󰍛 %percentage_used"
    threshold_degraded = "20%"
}
cpu_temperature 0 {
    format = " %degrees°C"
    path = "/sys/class/thermal/thermal_zone0/temp"
    max_threshold = 70
}
tztime local {
    format = "%a %m/%d  %H:%M "
}
