#!/data/data/com.termux/files/usr/bin/python
# Calendar in rofi (Super+Space → Calendar): a month with Taiwan public holidays and NYSE closures.
#   omp-cal [YYYY-MM]   ← / → change month, Esc closes
# Taiwan: 人事行政總處 calendar via github.com/ruyut/TaiwanCalendar, cached per year in ~/.cache/omarchy-pad.
# NYSE: full closures from the `holidays` package (install.sh pip-installs it); 13:00 ET early closes by rule.
import calendar, datetime as dt, html, json, os, subprocess, sys, urllib.request

CACHE = os.path.expanduser("~/.cache/omarchy-pad")
TW_URL = "https://cdn.jsdelivr.net/gh/ruyut/TaiwanCalendar/data/{}.json"
RED, YELLOW, CYAN, GREEN = "#f7768e", "#e0af68", "#7dcfff", "#9ece6a"
FG, MUTED, DIM, ACCENT, BG, BG_ALT = "#c0caf5", "#565f89", "#3b4261", "#7aa2f7", "#1a1b26", "#24283b"
WEEK = "日一二三四五六"
# The message box is sized by its theme font, so that is the big one (title, grid) and the notes under the grid
# are made smaller with a span: text larger than the theme font got its last lines clipped.
BIG, SMALL = "JetBrainsMono Nerd Font 15", "JetBrainsMono Nerd Font 10"


def taiwan(year):
    """{date: (is_holiday, description)}, or None when the year can't be fetched"""
    f = os.path.join(CACHE, f"tw-{year}.json")
    if not os.path.exists(f):
        try:
            data = urllib.request.urlopen(TW_URL.format(year), timeout=5).read()
            json.loads(data)
        except (OSError, ValueError):
            return None
        os.makedirs(CACHE, exist_ok=True)
        open(f, "wb").write(data)
    return {dt.datetime.strptime(d["date"], "%Y%m%d").date(): (d["isHoliday"], d["description"])
            for d in json.load(open(f, encoding="utf-8"))}


def nyse(year):
    """{date: text} closures and early closes"""
    try:
        import holidays
        out = {d: f"休市 · {n}" for d, n in holidays.financial_holidays("NYSE", years=year).items()}
    except ImportError:
        return {}
    thanksgiving = [dt.date(year, 11, d) for d in range(1, 31) if dt.date(year, 11, d).weekday() == 3][3]
    early = [thanksgiving + dt.timedelta(days=1)]
    for d in (dt.date(year, 7, 3), dt.date(year, 12, 24)):   # eve of a holiday that falls Tue-Fri
        if d.weekday() <= 3:
            early.append(d)
    for d in early:
        out.setdefault(d, "提早收盤 13:00 ET")
    return out


def wd(d):
    return WEEK[(d.weekday() + 1) % 7]


def span(text, **attrs):   # one Pango span; attrs never repeat, a repeated one breaks the whole markup
    return "<span " + " ".join(f'{k}="{v}"' for k, v in attrs.items()) + f">{text}</span>"


def pill(text, bg):
    return span(f" {text} ", background=bg, color=BG, weight="bold")


def today_line(today):
    tw, us = taiwan(today.year) or {}, nyse(today.year)
    off = tw.get(today, (today.weekday() >= 5, ""))[0]
    closed = today.weekday() >= 5 or (today in us and us[today].startswith("休市"))
    early = today in us and not closed
    t = span("● 台灣放假" if off else "● 台灣上班", color=RED if off else GREEN)
    u = span("● 美股休市" if closed else "● 美股提早收盤" if early else "● 美股開市",
             color=RED if closed else YELLOW if early else GREEN)
    return f'{span(f"今天 {today.month}/{today.day}（{wd(today)}）", color=FG, weight="bold")}   {t}   {u}'


def upcoming(today):
    """next Taiwan holiday or NYSE closure after today, as one line"""
    for y in (today.year, today.year + 1):
        tw, us = taiwan(y) or {}, nyse(y)
        days = sorted(d for d in set(k for k in tw if tw[k][1]) | set(us) if d > today)
        if days:
            d = days[0]
            what = tw[d][1] if d in tw and tw[d][1] else "美股" + us[d]
            n = (d - today).days
            return span(f"下一個：{d.month}/{d.day}（{wd(d)}）{html.escape(what)} · {n} 天後", color=MUTED)
    return ""


def render(year, month):
    tw = taiwan(year) or {}
    us = nyse(year)
    today = dt.date.today()
    title = span(f"{month} 月", weight="bold", color=ACCENT) + " " + span(str(year), color=MUTED)
    head = "".join(span(f" {w} ", color=RED if w == "日" else MUTED if w == "六" else FG, weight="bold") for w in WEEK)
    grid = [head]
    for week in calendar.Calendar(firstweekday=6).monthdatescalendar(year, month):
        cells = []
        for d in week:
            hol, desc = tw.get(d, (d.weekday() >= 5, ""))
            attrs = {"color": DIM if d.month != month else RED if hol and desc else MUTED if hol
                     else CYAN if d.weekday() >= 5 else FG}   # weekday-colored weekend = 補班
            if d.month == month and d in us:
                attrs.update(underline="double", underline_color=YELLOW)
            if d.month == month and hol and desc:
                attrs["weight"] = "bold"
            if d == today:
                attrs.update(background=ACCENT, color=BG, weight="bold")
            cells.append(span(f" {d.day:>2} ", **attrs))
        grid.append("".join(cells))
    rule = span("─" * 28, color=BG_ALT)
    legend = "   ".join(span("●", color=c) + span(f" {t}", color=MUTED) for c, t in
                       ((RED, "台灣假日"), (CYAN, "補班"), (YELLOW, "美股休市（雙底線）"), (ACCENT, "今天")))
    lines = [title, "", "\n".join(grid), "", span("\n".join([legend, rule, today_line(today), upcoming(today)]), font=SMALL)]
    if not tw:
        lines.append(span(f"{year} 年台灣行事曆還沒公布或下載失敗", color=YELLOW, font=SMALL))

    rows = []
    for d in sorted(set(k for k in tw if k.month == month and tw[k][1]) | set(k for k in us if k.month == month)):
        n = (d - today).days
        when = "今天" if n == 0 else f"{n} 天後" if n > 0 else "已過"
        past = n < 0
        date = span(f"{d.month:2d}/{d.day:02d} {wd(d)}", color=MUTED if past else FG)
        items = []
        if d in tw and tw[d][1]:
            items.append((pill("台灣", MUTED if past else RED), tw[d][1]))
        if d in us:
            items.append((pill("美股", MUTED if past else YELLOW), us[d]))
        for tag, text in items:
            rows.append(f'{date}  {tag}  {span(html.escape(text), color=MUTED if past else FG)}  {span(when, color=DIM if past else MUTED)}')
    return "\n".join(lines), rows or [span("這個月沒有台灣假日或美股休市", color=MUTED)]


def main():
    arg = sys.argv[1] if sys.argv[1:] else dt.date.today().strftime("%Y-%m")
    year, month = map(int, arg.split("-"))
    while True:
        msg, rows = render(year, month)
        r = subprocess.run(["rofi", "-dmenu", "-i", "-no-custom", "-markup-rows", "-dpi", os.environ.get("OMP_DPI", "180"),
                            "-p", "󰃭", "-mesg", msg,
                            "-kb-move-char-back", "Control+b", "-kb-move-char-forward", "Control+f",
                            "-kb-custom-1", "Left", "-kb-custom-2", "Right",
                            # one quoted string per -theme-str: rofi's parser runs a quoted value on to the last quote
                            "-theme-str", "window { width: 62ch; } textbox { horizontal-align: 0.5; } "
                                          "listview { lines: %d; scrollbar: false; } " % min(len(rows), 8),
                            "-theme-str", 'entry { placeholder: "搜尋假日   ← → 換月   Esc 關閉"; }',
                            "-theme-str", f'textbox {{ font: "{BIG}"; }}',
                            "-theme-str", f'element-text {{ font: "{SMALL}"; }}'],
                           input="\n".join(rows), capture_output=True, text=True)
        if r.returncode == 10:
            year, month = (year, month - 1) if month > 1 else (year - 1, 12)
        elif r.returncode == 11:
            year, month = (year, month + 1) if month < 12 else (year + 1, 1)
        else:
            return


main()
