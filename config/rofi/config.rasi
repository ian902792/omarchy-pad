configuration {
    modi: "drun,window,run";
    show-icons: true;
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
}
* {
    bg: #1a1b26; bg-alt: #24283b; fg: #a9b1d6; accent: #7aa2f7; muted: #565f89;
    background-color: @bg; text-color: @fg;
}
window { width: 36%; border: 2px solid; border-color: #7aa2f7; padding: 10px; background-color: @bg; }
inputbar { children: [prompt, entry]; spacing: 12px; padding: 10px 12px; margin: 0 0 12px 0; background-color: @bg-alt; }
prompt, entry { background-color: inherit; vertical-align: 0.5; }
prompt { text-color: @accent; }
entry { text-color: #c0caf5; cursor-color: @accent; placeholder: "Search"; placeholder-color: @muted; }
message { padding: 4px 0 12px 0; margin: 0 0 8px 0; border: 0 0 1px 0; border-color: @bg-alt; }
textbox { background-color: inherit; text-color: @fg; }
listview { lines: 8; spacing: 4px; fixed-height: false; }
element { padding: 8px 10px; spacing: 10px; }
element normal.normal, element alternate.normal { background-color: @bg; text-color: @fg; }
element selected.normal { background-color: @bg-alt; text-color: @accent; }
element-icon, element-text { background-color: inherit; text-color: inherit; }
element-icon { size: 1.2em; }
