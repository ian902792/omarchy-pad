#!/data/data/com.termux/files/usr/bin/python
# Render the i3 key cheat sheet into config/kitty/watermark.png (kitty draws it centered behind the text).
# Entries come from "#:" lines in config/i3/config. Re-run after editing: omp-watermark
import os, re
from PIL import Image, ImageDraw, ImageFont

ROOT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
NAMES = {"$mod": "Super", "space": "Space", "Escape": "Escape", "Return": "Return",
         "Left": "←", "Right": "→", "Up": "↑", "Down": "↓", "minus": "-", "equal": "="}

def label(combo):   # "$mod+Shift+s" -> "Super+Shift+S"
    return "+".join(NAMES.get(k, k.upper() if len(k) == 1 else k) for k in combo.split("+"))

def keys(conf):
    out, pending = [], None
    for line in open(conf, encoding="utf-8"):
        line = line.strip()
        if line.startswith("#:"):
            text = line[2:].strip()
            if "|" in text:
                k, d = (x.strip() for x in text.split("|", 1))
                out.append((k, d))
            else:
                pending = text
        elif pending and line.startswith("bindsym "):
            combo = re.split(r"\s+", line)[1]
            out.append((label(combo), pending))
            pending = None
    return out

KEYS = keys(os.path.join(ROOT, "config", "i3", "config"))
BG, KEY, DESC = "#1a1b26", "#454d70", "#363c58"   # faint on the Tokyo Night background
S = int(os.environ.get("OMP_SCALE", "75")) / 100   # start.sh exports it; X runs at S x native
SIZE = round(40 * S)   # 40 px at native resolution (~16 logical px)
mono = ImageFont.truetype(os.path.expandvars("$PREFIX/share/fonts/JetBrainsMonoNF/JetBrainsMonoNerdFont-Regular.ttf"), SIZE)
cjk = ImageFont.truetype("/system/fonts/NotoSansCJK-Regular.ttc", SIZE, index=3)  # 0 JP, 1 KR, 2 SC, 3 TC
line, gap = int(SIZE * 1.7), SIZE * 2
kw = max(mono.getlength(k) for k, _ in KEYS)
dw = max(cjk.getlength(d) for _, d in KEYS)
# Full-screen canvas: kitty paints black outside the image, and "centered" crops it evenly in any window size.
W, H = int(3392 * S), int(2400 * S)   # OPPO Pad 4 Pro panel at the X resolution
img = Image.new("RGB", (W, H), BG)
draw = ImageDraw.Draw(img)
x0 = (W - (kw + gap + dw)) / 2
y0 = (H - line * len(KEYS)) / 2
for i, (k, d) in enumerate(KEYS):
    y = y0 + i * line
    draw.text((x0 + kw - mono.getlength(k), y), k, font=mono, fill=KEY)
    draw.text((x0 + kw + gap, y), d, font=cjk, fill=DESC)
out = os.path.join(ROOT, "config", "kitty", "watermark.png")
img.save(out)
print(os.path.realpath(out))
