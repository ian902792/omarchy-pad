/* Generated by omarchy-pad render.sh from configs/eww/eww.scss.tpl - edit the template. */
* { all: unset; font-family: "Sans"; }

.card {
  background-color: rgba(@SURFACE_RGB@, 0.55);
  border: @px:1@px solid rgba(@FG_RGB@, 0.14);
  border-radius: @px:22@px;
  padding: @px:14@px @px:20@px;
}
.time    { font-size: @px:46@px; font-weight: bold; color: @FG@; }
.date    { font-size: @px:15@px; color: @SUBTEXT@; }

.ring       { background-color: rgba(@FG_RGB@, 0.12); color: @BLUE@; }
.ring-temp  { color: @MAUVE@; }
.ring-value { font-size: @px:18@px; font-weight: bold; color: @FG@; }
.ring-caption { font-size: @px:12@px; color: @SUBTEXT@; }
