# Generated by omarchy-pad render.sh from configs/sxhkd/sxhkdrc.tpl - edit the template.
# MOD = @MOD@  (OMP_MOD in ~/.config/omarchy-pad/env; alt by default because ColorOS captures Super)

# --- launch ---
@MOD@ + Return
	@TERMINAL@
@MOD@ + {space,d}
	rofi -show drun
@MOD@ + Tab
	rofi -show window
@MOD@ + shift + space
	rofi -show run

# --- windows ---
@MOD@ + {w,shift + w}
	bspc node -{c,k}
@MOD@ + f
	bspc node -t "~fullscreen"
@MOD@ + v
	bspc node -t "~floating"
@MOD@ + m
	bspc desktop -l next
@MOD@ + t
	bspc node -t tiled

# --- focus / swap (vim keys and arrows) ---
@MOD@ + {_,shift + }{h,j,k,l}
	bspc node -{f,s} {west,south,north,east}
@MOD@ + {_,shift + }{Left,Down,Up,Right}
	bspc node -{f,s} {west,south,north,east}
@MOD@ + {comma,period}
	bspc node -f {prev,next}.local.!hidden.window

# --- resize ---
@MOD@ + ctrl + {h,j,k,l}
	bspc node -z {left -40 0,bottom 0 40,top 0 -40,right 40 0}
@MOD@ + ctrl + {Left,Down,Up,Right}
	bspc node -z {left -40 0,bottom 0 40,top 0 -40,right 40 0}

# --- desktops ---
@MOD@ + {1-6}
	bspc desktop -f '^{1-6}'
@MOD@ + shift + {1-6}
	bspc node -d '^{1-6}' --follow

# --- session ---
@MOD@ + shift + r
	bspc wm -r
@MOD@ + shift + c
	pkill -USR1 -x sxhkd
@MOD@ + shift + e
	bspc quit
@MOD@ + shift + t
	@ROOT@/set-theme.sh toggle
