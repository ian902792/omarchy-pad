#!/bin/sh
# Generated by omarchy-pad render.sh from configs/bspwm/bspwmrc.tpl - edit the template.
[ -r "$HOME/.config/omarchy-pad/env" ] && . "$HOME/.config/omarchy-pad/env"

bspc monitor -d 1 2 3 4 5 6

bspc config border_width         @BORDER@
bspc config window_gap           @GAP@
bspc config split_ratio          0.55
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config focus_follows_pointer false
bspc config pointer_follows_focus false
bspc config click_to_focus       button1

bspc config normal_border_color  "@SURFACE1@"
bspc config active_border_color  "@MAUVE@"
bspc config focused_border_color "@BLUE@"
bspc config presel_feedback_color "@GREEN@"

# Dialogs / utilities float
bspc rule -a Rofi state=floating
bspc rule -a Xfce4-appfinder state=floating
bspc rule -a Pavucontrol state=floating

# Helpers (idempotent: safe to re-run for live theme reload)
xrdb -merge "$HOME/.Xresources" 2>/dev/null
xsetroot -cursor_name left_ptr 2>/dev/null
"@SCRIPTS@/wallpaper.sh" &
pgrep -x sxhkd >/dev/null || sxhkd &
"@SCRIPTS@/polybar-launch.sh" &
# First screen: open one terminal if there is no window yet (only for a fresh start)
if [ -n "$OMP_AUTOSTART" ] && [ -z "$(bspc query -N -n .window)" ]; then
    ( sleep 1.5; @TERMINAL@ ) &
fi
