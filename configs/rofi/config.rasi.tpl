/* Generated by omarchy-pad render.sh from configs/rofi/config.rasi.tpl - edit the template. */
configuration {
    dpi: @DPI@;
    modi: "drun,run,window";
    show-icons: false;
    font: "monospace 14";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    drun-display-format: "{name}";
}

* {
    background-color: transparent;
    text-color: @FG@;
}

window {
    location: center;
    width: 40%;
    background-color: @BG@;
    border: 3px;
    border-color: @MAUVE@;
    border-radius: 16px;
}
mainbox { padding: 18px; spacing: 12px; children: [inputbar, listview]; }
inputbar {
    padding: 12px 16px;
    spacing: 10px;
    background-color: @SURFACE@;
    border-radius: 12px;
    children: [prompt, entry];
}
prompt { text-color: @MAUVE@; }
entry { placeholder: "search..."; placeholder-color: @MUTED@; }
listview { lines: 8; columns: 1; spacing: 6px; scrollbar: false; }
element { padding: 10px 14px; border-radius: 10px; background-color: transparent; text-color: @FG@; }
element normal.normal, element alternate.normal { background-color: transparent; text-color: @FG@; }
element selected.normal { background-color: @SURFACE@; text-color: @BLUE@; border: 0 0 0 3px; border-color: @MAUVE@; }
element-text { background-color: transparent; text-color: inherit; }
