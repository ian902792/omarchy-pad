; Generated by omarchy-pad render.sh from configs/polybar/config.ini.tpl - edit the template.
[colors]
background = @BG@
surface = @SURFACE@
foreground = @FG@
muted = @MUTED@
blue = @BLUE@
mauve = @MAUVE@
green = @GREEN@
red = @RED@

[bar/main]
width = 100%
height = @BAR_H@
dpi = @DPI@
background = ${colors.background}
foreground = ${colors.foreground}
line-size = 3
padding = 2
module-margin = 2
font-0 = monospace:size=11;3
font-1 = Symbols Nerd Font:size=11;3
modules-left = bspwm
modules-center = xwindow
modules-right = network battery date
enable-ipc = true
wm-restack = bspwm
cursor-click = pointer

[module/bspwm]
type = internal/bspwm
pin-workspaces = true
label-focused = %name%
label-focused-background = ${colors.surface}
label-focused-foreground = ${colors.blue}
label-focused-underline = ${colors.mauve}
label-focused-padding = 2
label-occupied = %name%
label-occupied-padding = 2
label-empty = %name%
label-empty-foreground = ${colors.muted}
label-empty-padding = 2
label-urgent = %name%
label-urgent-foreground = ${colors.red}
label-urgent-padding = 2

[module/xwindow]
type = internal/xwindow
label = %title:0:60:...%
label-foreground = ${colors.foreground}

; Android does not expose Linux-style battery/Wi-Fi interfaces to Termux reliably.
; These scripts print nothing (module hidden) when no data source is readable.
[module/network]
type = custom/script
exec = @SCRIPTS@/status-network.sh
interval = 15
format-foreground = ${colors.green}

[module/battery]
type = custom/script
exec = @SCRIPTS@/status-battery.sh
interval = 30
format-foreground = ${colors.mauve}

[module/date]
type = internal/date
interval = 5
date = %a %m/%d
time = %H:%M
label = %date%  %time%
label-foreground = ${colors.blue}

[settings]
screenchange-reload = true
pseudo-transparency = false
