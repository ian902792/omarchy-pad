#!/data/data/com.termux/files/usr/bin/python
# Render the i3 key cheat sheet into config/kitty/watermark.png (kitty draws it centered behind the text).
# Entries come from "#:" lines in config/i3/config. Re-run after editing: omp-watermark
import os, re, subprocess
from PIL import Image, ImageDraw, ImageFont

ROOT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
NAMES = {"$mod": "Super", "space": "Space", "Escape": "Escape", "Return": "Return",
         "Left": "←", "Right": "→", "Up": "↑", "Down": "↓", "minus": "-", "equal": "="}

def label(combo):   # "$mod+Shift+s" -> "Super+Shift+S"
    return "+".join(NAMES.get(k, k.upper() if len(k) == 1 else k) for k in combo.split("+"))

def keys(conf):
    out, pending = [], None
    for line in open(conf, encoding="utf-8"):
        line = line.strip()
        if line.startswith("#:"):
            text = line[2:].strip()
            if "|" in text:
                k, d = (x.strip() for x in text.split("|", 1))
                out.append((k, d))
            else:
                pending = text
        elif pending and line.startswith("bindsym "):
            combo = re.split(r"\s+", line)[1]
            out.append((label(combo), pending))
            pending = None
    return out

KEYS = keys(os.path.join(ROOT, "config", "i3", "config"))

def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip()
    except OSError:
        return ""

def info():   # fastfetch-style block above the keys; read once per render
    prop = lambda k: run("/system/bin/getprop", k)
    soc = prop("ro.soc.model")
    cpu = {"SM8750": "Snapdragon 8 Elite"}.get(soc[:6], soc)
    mem = int(next(l.split()[1] for l in open("/proc/meminfo") if l.startswith("MemTotal"))) / 2**20
    icons = re.search(r"icon-theme-name=(.*)", open(os.path.join(ROOT, "config", "gtk-3.0", "settings.ini")).read())
    sc = int(os.environ.get("OMP_SCALE", "75"))
    return [
        ("OS", f"Termux on Android {prop('ro.build.version.release')} (ColorOS {prop('ro.build.version.oplusrom').lstrip('V')})"),
        ("Kernel", "Linux " + run("uname", "-r").split("-g")[0]),
        ("WM", run("i3", "--version").split(" (")[0].replace(" version", "")),
        ("Terminal", " ".join(run("kitty", "--version").split()[:2])),
        ("Shell", "bash " + run("bash", "-c", "echo ${BASH_VERSION%%(*}")),
        ("Theme", "Tokyo Night · " + (icons.group(1).strip() if icons else "")),
        ("CPU", f"{cpu} ({soc}) · {os.cpu_count()} cores"),
        ("GPU", "Adreno 830 · zink / Turnip"),
        ("Memory", f"{mem:.0f} GiB"),
        ("Display", f"{3392 * sc // 100}x{2400 * sc // 100} ({sc}% of 3392x2400)"),
    ]
BG, KEY, DESC, TITLE = "#1a1b26", "#454d70", "#363c58", "#34467a"   # faint on the Tokyo Night background
S = int(os.environ.get("OMP_SCALE", "75")) / 100   # start.sh exports it; X runs at S x native
SIZE = round(40 * S)   # 40 px at native resolution (~16 logical px)
mono = ImageFont.truetype(os.path.expandvars("$PREFIX/share/fonts/JetBrainsMonoNF/JetBrainsMonoNerdFont-Regular.ttf"), SIZE)
cjk = ImageFont.truetype("/system/fonts/NotoSansCJK-Regular.ttc", SIZE, index=3)  # 0 JP, 1 KR, 2 SC, 3 TC
line, gap = int(SIZE * 1.7), SIZE * 2
INFO = info()
TITLE_TEXT = "omarchy-pad"
# rows: title, info (mono values), blank, keys (CJK descriptions)
ROWS = [None] + [(k, v, mono) for k, v in INFO] + [None] + [(k, d, cjk) for k, d in KEYS]
kw = max(mono.getlength(r[0]) for r in ROWS if r)
dw = max(r[2].getlength(r[1]) for r in ROWS if r)
# Full-screen canvas: kitty paints black outside the image, and "centered" crops it evenly in any window size.
W, H = int(3392 * S), int(2400 * S)   # OPPO Pad 4 Pro panel at the X resolution
img = Image.new("RGB", (W, H), BG)
draw = ImageDraw.Draw(img)
x0 = (W - (kw + gap + dw)) / 2
y0 = (H - line * (len(ROWS) + 1)) / 2
draw.text((x0 + kw + gap, y0), TITLE_TEXT, font=mono, fill=TITLE)
for i, r in enumerate(ROWS[1:], 2):
    if r:
        k, d, font = r
        draw.text((x0 + kw - mono.getlength(k), y0 + i * line), k, font=mono, fill=KEY)
        draw.text((x0 + kw + gap, y0 + i * line), d, font=font, fill=DESC)
out = os.path.join(ROOT, "config", "kitty", "watermark.png")
img.save(out)
print(os.path.realpath(out))
